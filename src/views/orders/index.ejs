<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard - Order Tracking</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --sidebar-bg: #0f172a;
      --sidebar-hover: #1e293b;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #334155;
      --text-light: #94a3b8;
      --border: #e2e8f0;
      
      --status-pending: #64748b;
      --status-ordered: #3b82f6;
      --status-received: #f59e0b;
      --status-invoiced: #8b5cf6;
      --status-dispatched: #10b981;
      --status-delivered: #06b6d4;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* Layout */
    aside.sidebar {
      width: 260px;
      background: var(--sidebar-bg);
      color: white;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }

    .sidebar-header {
      padding: 20px;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.5px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-links {
      flex: 1;
      padding: 20px 0;
    }

    .nav-item {
      padding: 12px 20px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 10px;
      color: #cbd5e1;
      border-right: 4px solid transparent;
      margin: 2px 0;
    }

    .nav-item:hover, .nav-item.active {
      background: var(--sidebar-hover);
      color: white;
      border-right: 4px solid var(--primary);
    }

    .nav-item svg {
      flex-shrink: 0;
      opacity: 0.8;
      transition: opacity 0.2s ease;
    }

    .nav-item:hover svg, .nav-item.active svg {
      opacity: 1;
    }

    .main-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    header.topbar {
      height: 64px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 30px;
      flex-shrink: 0;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .user-badge {
      background: var(--primary);
      color: white;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }

    main.content {
      flex: 1;
      overflow-y: auto;
      padding: 30px;
    }

    footer.bottombar {
      height: 48px;
      background: var(--surface);
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      color: var(--text-light);
      flex-shrink: 0;
    }

    /* Components */
    .tab-content { display: none; animation: fadeIn 0.3s ease; }
    .tab-content.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .card {
      background: var(--surface);
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05);
      padding: 24px;
      margin-bottom: 24px;
      border: 1px solid var(--border);
    }

    .card h3 { margin-bottom: 20px; font-weight: 600; color: #1e293b; }

    /* Forms */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    label { font-size: 14px; font-weight: 500; color: #475569; }

    input, select {
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-family: inherit;
      font-size: 14px;
      transition: all 0.2s;
    }

    input:focus, select:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    input.auto-filled {
      background-color: #f0fdf4;
      border-color: #86efac;
    }

    .btn {
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); }
    
    .btn-danger { background: #ef4444; color: white; padding: 6px 12px; font-size: 13px; }
    .btn-danger:hover { background: #dc2626; }

    .btn-sm { padding: 6px 12px; font-size: 13px; }

    /* Table */
    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      padding: 16px;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    th {
      font-weight: 600;
      color: #64748b;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #f8fafc; }

    .status-badge {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      display: inline-block;
      text-transform: uppercase;
      background: #f1f5f9; /* Default gray background */
      color: #64748b;      /* Default gray text */
    }

    .status-PENDING { background: #e2e8f0; color: #475569; }
    .status-ORDERED { background: #dbeafe; color: #1e40af; }
    .status-RECEIVED { background: #fef3c7; color: #92400e; }
    .status-INVOICED { background: #ede9fe; color: #6d28d9; }
    .status-DISPATCHED { background: #dcfce7; color: #15803d; }
    .status-DELIVERED { background: #dcfce7; color: #15803d; }

    /* Machinery steps usually don't have individual classes, so they use the default gray above. 
       Let's make them slightly more distinct if they are active. */
    tr:hover .status-badge { opacity: 0.9; }

    /* Dashboard Stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat-card {
      background: white;
      padding: 20px;
      border-radius: 12px;
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
    }

    .stat-title { color: var(--text-light); font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;}
    .stat-value { font-size: 28px; font-weight: 700; color: #0f172a; }

    /* Sub-tabs */
    .sub-tabs {
      display: flex;
      gap: 8px;
      padding: 16px 24px;
      background: #f8fafc;
      border-bottom: 1px solid var(--border);
    }
    .sub-tab {
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
      cursor: pointer;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .sub-tab:hover { background: #e2e8f0; color: #1e293b; }
    .sub-tab.active { background: #eef2ff; color: #4f46e5; }
  </style>
</head>

<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
      KIET TECHNOLOGIES
    </div>
    <div class="nav-links">
      <div class="nav-item active" onclick="switchTab('dashboard', this)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        Dashboard
      </div>
      <div class="nav-item" onclick="switchTab('orders', this)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        Orders List
      </div>
      <div class="nav-item" onclick="switchTab('tickets', this)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"></path><path d="M20 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h11"></path></svg>
        Tickets
      </div>
      <% if (user.role === 'ADMIN') { %>
      <div class="nav-item" onclick="switchTab('create', this)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Create Order
      </div>
      <div class="nav-item" onclick="switchTab('suppliers', this)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        Suppliers
      </div>
      <div class="nav-item" onclick="switchTab('register', this)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle><line x1="12" y1="12" x2="12" y2="18"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
        Register User
      </div>
      <% } %>
    </div>
  </aside>

  <div class="main-wrapper">
    <!-- Header -->
    <header class="topbar">
      <div>
        <h2 style="font-size: 18px; font-weight: 600; color: #1e293b;" id="page-title">Dashboard</h2>
      </div>
      <div class="user-info">
        <span class="user-badge"><%= user.role %></span>
        <span style="font-size: 14px; font-weight: 500;"><%= user.email %></span>
        <a href="/auth/logout" class="btn btn-danger">Logout</a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="content">

      <!-- View: Dashboard -->
      <div id="tab-dashboard" class="tab-content active">
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-title">Total Orders</span>
            <span class="stat-value"><%= orders.length %></span>
          </div>
          <div class="stat-card">
            <span class="stat-title">Pending</span>
            <span class="stat-value"><%= orders.filter(o => o.status === 'PENDING').length %></span>
          </div>
          <div class="stat-card">
            <span class="stat-title">Dispatched</span>
            <span class="stat-value"><%= orders.filter(o => o.status === 'DISPATCHED').length %></span>
          </div>
          <div class="stat-card">
            <span class="stat-title">Total Tickets</span>
            <span class="stat-value"><%= (tickets || []).length %></span>
          </div>
          <div class="stat-card">
            <span class="stat-title">Active Tickets</span>
            <span class="stat-value"><%= (tickets || []).filter(t => ['OPEN', 'IN_PROGRESS'].includes(t.status)).length %></span>
          </div>
          <div class="stat-card">
            <span class="stat-title">Urgent</span>
            <span class="stat-value"><%= (tickets || []).filter(t => t.priority === 'URGENT').length %></span>
          </div>
        </div>

        <div class="card" style="margin-top: 24px;">
          <h3 style="margin-bottom: 24px;">Order Type Distribution</h3>
          <div style="max-height: 250px; display: flex; justify-content: center; margin-bottom: 20px;">
            <canvas id="orderTypeChart"></canvas>
          </div>
          <div style="display: flex; justify-content: center; gap: 30px; padding-top: 15px; border-top: 1px solid #f1f5f9;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="width: 10px; height: 10px; background: #4f46e5; border-radius: 50%;"></span>
              <span style="font-size: 14px; font-weight: 600; color: #1e293b;">Trading (<%= orderStats.trading %>)</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="width: 10px; height: 10px; background: rgb(128 92 31); border-radius: 50%;"></span>
              <span style="font-size: 14px; font-weight: 600; color: #1e293b;">Machinery (<%= orderStats.machinery %>)</span>
            </div>
          </div>
        </div>

        <div class="card" style="margin-top: 24px; padding: 0;">
          <div style="padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0;">Recent Orders</h3>
            <button onclick="switchTab('orders', document.querySelector('[onclick*=\'orders\']'))" class="btn btn-primary btn-sm" style="background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe;">View All</button>
          </div>
          <div style="overflow-x: auto;">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>PO Number</th>
                  <th>Order</th>
                  <th>Type</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% orders.slice(0, 5).forEach(order => { %>
                  <tr>
                    <td><strong style="color: #0f172a;">#<%= order.id %></strong></td>
                    <td><%= order.po_number %></td>
                    <td style="max-width: 200px;">
                      <div style="display: flex; flex-direction: column; gap: 2px;">
                        <strong style="font-size: 13px; color: #1e293b;"><%= order.product_name || 'N/A' %></strong>
                        <% if (user.role === 'ADMIN') { %>
                        <small style="color: #64748b; font-size: 11px;">Client: <%= order.client_name || 'N/A' %></small>
                        <% } %>
                      </div>
                    </td>
                    <td>
                      <% 
                        let typeColor = order.order_type === 'MACHINERY' ? 'rgb(128 92 31)' : '#4f46e5';
                        let typeBg = order.order_type === 'MACHINERY' ? 'rgb(128 92 31 / 15%)' : '#eef2ff';
                      %>
                      <span style="font-size: 11px; font-weight: 600; color: <%= typeColor %>; background: <%= typeBg %>; padding: 2px 8px; border-radius: 4px; text-transform: capitalize; border: 1px solid <%= order.order_type === 'MACHINERY' ? 'rgb(128 92 31 / 30%)' : 'transparent' %>;">
                        <%= (order.order_type || 'TRADING').toLowerCase() %>
                      </span>
                    </td>
                    <td><span class="status-badge status-<%= order.status %>"><%= order.status %></span></td>
                    <td><a href="/orders/<%= order.id %>" class="btn btn-primary btn-sm">View</a></td>
                  </tr>
                <% }) %>
                <% if (orders.length === 0) { %>
                  <tr><td colspan="6" style="text-align: center; color: #94a3b8; padding: 30px;">No orders found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- View: Orders List -->
      <div id="tab-orders" class="tab-content">
        <div class="card" style="padding: 0;">
          <div style="padding: 20px 24px; border-bottom: 1px solid var(--border);">
            <h3 style="margin: 0; margin-bottom: 16px;">All Orders <% if (searchQuery) { %><span style="font-size: 14px; color: #64748b; font-weight: 400;">- Search: "<%= searchQuery %>"</span><% } %></h3>
            <form method="GET" action="/orders#orders" style="display: flex; gap: 10px; max-width: 400px;">
              <input type="text" name="search" placeholder="Search by PO Number or Supplier..." style="flex: 1;" value="<%= searchQuery || '' %>" />
              <button type="submit" class="btn btn-primary" style="padding: 10px 20px;">Search</button>
              <% if (searchQuery) { %>
              <a href="/orders#orders" class="btn" style="padding: 10px 20px; background: #e2e8f0; color: #475569; cursor: pointer; text-decoration: none;">Clear</a>
              <% } %>
            </form>
          </div>
          <div class="sub-tabs">
            <div class="sub-tab active" onclick="filterOrders('ALL', this)">All Orders</div>
            <div class="sub-tab" onclick="filterOrders('TRADING', this)">Trading</div>
            <div class="sub-tab" onclick="filterOrders('MACHINERY', this)">Machinery</div>
          </div>
          <div style="overflow-x: auto;">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>PO Number</th>
                  <th>Order</th>
                  <th>Type</th>
                  <th>Status</th>
                  <th>Created Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (orders.length === 0) { %>
                  <tr><td colspan="7" style="text-align: center; color: #94a3b8; padding: 30px;">No orders found</td></tr>
                <% } %>
                <% orders.forEach(order => { %>
                  <tr class="order-row" data-type="<%= order.order_type || 'TRADING' %>">
                    <td><strong style="color: #0f172a;">#<%= order.id %></strong></td>
                    <td><%= order.po_number %></td>
                    <td style="max-width: 250px;">
                      <div style="display: flex; flex-direction: column; gap: 2px;">
                        <strong style="font-size: 14px; color: #1e293b;"><%= order.product_name || 'N/A' %></strong>
                        <% if (user.role === 'ADMIN') { %>
                        <small style="color: #64748b; font-weight: 500;">
                          Client: <%= order.client_name || 'N/A' %>
                        </small>
                        <% } %>
                      </div>
                    </td>
                    <td>
                      <% 
                        let typeColor = order.order_type === 'MACHINERY' ? 'rgb(128 92 31)' : '#4f46e5';
                        let typeBg = order.order_type === 'MACHINERY' ? 'rgb(128 92 31 / 15%)' : '#eef2ff';
                      %>
                      <span style="font-size: 13px; font-weight: 600; color: <%= typeColor %>; background: <%= typeBg %>; padding: 3px 10px; border-radius: 6px; text-transform: capitalize; border: 1px solid <%= order.order_type === 'MACHINERY' ? 'rgb(128 92 31 / 30%)' : 'transparent' %>;">
                        <%= (order.order_type || 'TRADING').toLowerCase() %>
                      </span>
                    </td>
                    <td><span class="status-badge status-<%= order.status %>"><%= order.status %></span></td>
                    <td><span style="color: #64748b; font-size: 13px;"><%= order.created_at ? new Date(order.created_at).toLocaleDateString() : 'N/A' %></span></td>
                    <td><a href="/orders/<%= order.id %>" class="btn btn-primary btn-sm">View Details</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- View: Create Order -->
      <% if (user.role === 'ADMIN') { %>
      <div id="tab-create" class="tab-content">
        <div class="card" style="max-width: 800px;">
          <h3>Create New Order</h3>
          <form method="POST" action="/orders">
            <div class="form-grid">
              <div class="form-group">
                <label>PO Number</label>
                <input type="text" name="po_number" placeholder="Enter PO Number" required />
              </div>
              <div class="form-group">
                <label>Client Email</label>
                <input type="email" name="client_email" id="clientEmailInput" placeholder="example@email.com" required />
              </div>
              <div class="form-group">
                <label>Client Name</label>
                <input type="text" name="client_name" id="clientNameInput" placeholder="Fetching name..." required />
              </div>
              <div class="form-group">
                <label>Supplier Name</label>
                <input type="text" name="supplier_name" placeholder="Supplier Name" />
              </div>
              <div class="form-group">
                <label>Expected Delivery Date</label>
                <input type="date" name="expected_delivery_date" required />
              </div>
              <div class="form-group">
                <label>Order Type</label>
                <select name="order_type" required>
                  <% Object.keys(ORDER_TYPES).forEach(type => { %>
                    <option value="<%= type %>"><%= ORDER_TYPES[type].label %></option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label>Product Name</label>
                <input type="text" name="product_name" placeholder="Enter product name" />
              </div>
              <div class="form-group" style="grid-column: 1 / -1;">
                <label>Description</label>
                <textarea name="description" placeholder="Enter product description..." style="padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 14px; resize: vertical; min-height: 80px;"></textarea>
              </div>
            </div>
            <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end;">
              <button type="submit" class="btn btn-primary" style="padding: 12px 30px; font-size: 15px;">Create Order</button>
            </div>
          </form>
        </div>
      </div>

      <!-- View: Suppliers Management -->
      <div id="tab-suppliers" class="tab-content">
        <div class="card" style="max-width: 800px; margin-bottom: 30px;">
          <h3>Add New Supplier</h3>
          <form method="POST" action="/suppliers">
            <div class="form-grid">
              <div class="form-group">
                <label>Supplier Name</label>
                <input type="text" name="name" placeholder="Enter supplier name" required />
              </div>
              <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="supplier@example.com" />
              </div>
              <div class="form-group">
                <label>Phone</label>
                <input type="tel" name="phone" placeholder="+91 (555) 000-0000" />
              </div>
              <div class="form-group" style="grid-column: 1 / -1;">
                <label>Address</label>
                <input type="text" name="address" placeholder="Enter supplier address" />
              </div>
            </div>
            <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end;">
              <button type="submit" class="btn btn-primary" style="padding: 12px 30px; font-size: 15px;">Add Supplier</button>
            </div>
          </form>
        </div>

        <div class="card" style="padding: 0;">
          <div style="padding: 20px 24px; border-bottom: 1px solid var(--border);">
            <h3 style="margin: 0;">Suppliers List</h3>
          </div>
          <div style="overflow-x: auto;">
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Address</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (suppliers && suppliers.length === 0) { %>
                  <tr><td colspan="5" style="text-align: center; color: #94a3b8; padding: 30px;">No suppliers added yet</td></tr>
                <% } %>
                <% (suppliers || []).forEach(supplier => { %>
                  <tr>
                    <td><strong style="color: #0f172a;"><%= supplier.name %></strong></td>
                    <td><span style="color: #64748b; font-size: 13px;"><%= supplier.email || '-' %></span></td>
                    <td><span style="color: #64748b; font-size: 13px;"><%= supplier.phone || '-' %></span></td>
                    <td><span style="color: #64748b; font-size: 13px;"><%= supplier.address || '-' %></span></td>
                    <td>
                      <form method="POST" action="/suppliers/<%= supplier.id %>/delete" style="display: inline;">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this supplier?');">Delete</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- View: Register User -->
      <div id="tab-register" class="tab-content">
        <div class="card" style="max-width: 800px;">
          <h3>Register New User</h3>
          <form method="POST" action="/auth/register">
            <div class="form-grid">
              <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="name" placeholder="Enter user full name" required />
              </div>
              <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="user@example.com" required />
              </div>
              <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="Enter password" required />
              </div>
              <div class="form-group">
                <label>Confirm Password</label>
                <input type="password" name="confirmPassword" placeholder="Confirm password" required />
              </div>
              <div class="form-group">
                <label>Role</label>
                <select name="role" style="padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 14px;">
                  <option value="CLIENT">Client</option>
                  <option value="ADMIN">Admin</option>
                </select>
              </div>
            </div>
            <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end;">
              <button type="submit" class="btn btn-primary" style="padding: 12px 30px; font-size: 15px;">Register User</button>
            </div>
          </form>
        </div>
      </div>
      <% } %>

      <!-- View: Tickets -->
      <div id="tab-tickets" class="tab-content">
        <% if (user.role !== 'ADMIN') { %>
        <div class="card" style="max-width: 900px; margin-bottom: 30px;">
          <h3>Raise a New Ticket</h3>
          <form method="POST" action="/tickets">
            <div class="form-grid">
              <div class="form-group" style="grid-column: 1 / -1;">
                <label>Subject</label>
                <input type="text" name="title" placeholder="Brief description of your issue" required />
              </div>
              <div class="form-group" style="grid-column: 1 / -1;">
                <label>Description</label>
                <textarea name="description" placeholder="Detailed description of your issue..." required style="padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 14px; resize: vertical; min-height: 120px;"></textarea>
              </div>
              <div class="form-group">
                <label>Priority</label>
                <select name="priority" style="padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 14px;">
                  <option value="LOW">Low</option>
                  <option value="MEDIUM" selected>Medium</option>
                  <option value="HIGH">High</option>
                  <option value="URGENT">Urgent</option>
                </select>
              </div>
            </div>
            <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end;">
              <button type="submit" class="btn btn-primary" style="padding: 12px 30px; font-size: 15px;">Create Ticket</button>
            </div>
          </form>
        </div>
        <% } %>

        <!-- Active Tickets Section -->
        <div class="card" style="padding: 0;">
          <div style="padding: 20px 24px; border-bottom: 1px solid var(--border);">
            <h3 style="margin: 0;"><% if (user.role === 'ADMIN') { %>Active Tickets<% } else { %>My Active Tickets<% } %></h3>
            <span style="color: #94a3b8; font-size: 13px;">Open, In Progress, and Resolved tickets</span>
          </div>
          <div style="overflow-x: auto;">
            <table>
              <thead>
                <tr>
                  <th>Ticket ID</th>
                  <% if (user.role === 'ADMIN') { %><th>Client</th><% } %>
                  <th>Subject</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% 
                  let activeTickets = (tickets || []).filter(t => ['OPEN', 'IN_PROGRESS', 'RESOLVED'].includes(t.status));
                  if (activeTickets.length === 0) { 
                %>
                  <tr><td colspan="<% if (user.role === 'ADMIN') { %>7<% } else { %>6<% } %>" style="text-align: center; color: #94a3b8; padding: 30px;">No active tickets</td></tr>
                <% } %>
                <% activeTickets.forEach(ticket => { %>
                  <tr>
                    <td><strong style="color: #0f172a;">#<%= ticket.id %></strong></td>
                    <% if (user.role === 'ADMIN') { %>
                    <td><span style="color: #475569; font-size: 13px;"><%= ticket.name %><br><span style="color: #94a3b8; font-size: 12px;"><%= ticket.email %></span></span></td>
                    <% } %>
                    <td><span style="color: #334155;"><%= ticket.title %></span></td>
                    <td>
                      <% 
                        let priorityBg = ticket.priority === 'URGENT' ? '#fecaca' : ticket.priority === 'HIGH' ? '#fed7aa' : ticket.priority === 'MEDIUM' ? '#fef08a' : '#dcfce7';
                        let priorityColor = ticket.priority === 'URGENT' ? '#dc2626' : ticket.priority === 'HIGH' ? '#d97706' : ticket.priority === 'MEDIUM' ? '#ca8a04' : '#16a34a';
                      %>
                      <span class="status-badge" style="background: <%= priorityBg %>; color: <%= priorityColor %>;">
                        <%= ticket.priority %>
                      </span>
                    </td>
                    <td>
                      <% 
                        let statusBg = ticket.status === 'OPEN' ? '#dbeafe' : ticket.status === 'IN_PROGRESS' ? '#fed7aa' : ticket.status === 'RESOLVED' ? '#d1fae5' : '#e5e7eb';
                        let statusColor = ticket.status === 'OPEN' ? '#0284c7' : ticket.status === 'IN_PROGRESS' ? '#d97706' : ticket.status === 'RESOLVED' ? '#059669' : '#4b5563';
                      %>
                      <span class="status-badge" style="background: <%= statusBg %>; color: <%= statusColor %>;">
                        <%= ticket.status %>
                      </span>
                    </td>
                    <td><span style="color: #64748b; font-size: 13px;"><%= ticket.created_at ? new Date(ticket.created_at).toLocaleDateString() : 'N/A' %></span></td>
                    <td><a href="/tickets/<%= ticket.id %>" class="btn btn-primary btn-sm">View Details</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Closed Tickets Section -->
        <div class="card" style="padding: 0; margin-top: 24px;">
          <div style="padding: 20px 24px; border-bottom: 1px solid var(--border);">
            <h3 style="margin: 0;"><% if (user.role === 'ADMIN') { %>Closed Tickets<% } else { %>My Closed Tickets<% } %></h3>
            <span style="color: #94a3b8; font-size: 13px;">Archived and completed tickets</span>
          </div>
          <div style="overflow-x: auto;">
            <table>
              <thead>
                <tr>
                  <th>Ticket ID</th>
                  <% if (user.role === 'ADMIN') { %><th>Client</th><% } %>
                  <th>Subject</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% 
                  let closedTickets = (tickets || []).filter(t => t.status === 'CLOSED');
                  if (closedTickets.length === 0) { 
                %>
                  <tr><td colspan="<% if (user.role === 'ADMIN') { %>7<% } else { %>6<% } %>" style="text-align: center; color: #94a3b8; padding: 30px;">No closed tickets</td></tr>
                <% } %>
                <% closedTickets.forEach(ticket => { %>
                  <tr>
                    <td><strong style="color: #0f172a;">#<%= ticket.id %></strong></td>
                    <% if (user.role === 'ADMIN') { %>
                    <td><span style="color: #475569; font-size: 13px;"><%= ticket.name %><br><span style="color: #94a3b8; font-size: 12px;"><%= ticket.email %></span></span></td>
                    <% } %>
                    <td><span style="color: #334155;"><%= ticket.title %></span></td>
                    <td>
                      <% 
                        let priorityBg = ticket.priority === 'URGENT' ? '#fecaca' : ticket.priority === 'HIGH' ? '#fed7aa' : ticket.priority === 'MEDIUM' ? '#fef08a' : '#dcfce7';
                        let priorityColor = ticket.priority === 'URGENT' ? '#dc2626' : ticket.priority === 'HIGH' ? '#d97706' : ticket.priority === 'MEDIUM' ? '#ca8a04' : '#16a34a';
                      %>
                      <span class="status-badge" style="background: <%= priorityBg %>; color: <%= priorityColor %>;">
                        <%= ticket.priority %>
                      </span>
                    </td>
                    <td>
                      <% 
                        let statusBg = ticket.status === 'OPEN' ? '#dbeafe' : ticket.status === 'IN_PROGRESS' ? '#fed7aa' : ticket.status === 'RESOLVED' ? '#d1fae5' : '#e5e7eb';
                        let statusColor = ticket.status === 'OPEN' ? '#0284c7' : ticket.status === 'IN_PROGRESS' ? '#d97706' : ticket.status === 'RESOLVED' ? '#059669' : '#4b5563';
                      %>
                      <span class="status-badge" style="background: <%= statusBg %>; color: <%= statusColor %>;">
                        <%= ticket.status %>
                      </span>
                    </td>
                    <td><span style="color: #64748b; font-size: 13px;"><%= ticket.created_at ? new Date(ticket.created_at).toLocaleDateString() : 'N/A' %></span></td>
                    <td><a href="/tickets/<%= ticket.id %>" class="btn btn-primary btn-sm">View Details</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>

    <!-- Footer -->
    <footer class="bottombar">
      &copy; KIET TECHNOLOGIES Panel UI. All rights reserved.
    </footer>
  </div>

  <script>
    function switchTab(tabId, element) {
      // Update nav styles
      document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
      if(element) element.classList.add('active');

      // Hide all tabs
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      
      // Show selected
      document.getElementById('tab-' + tabId).classList.add('active');

      // Update Header Title
      const titles = {
        'dashboard': 'Dashboard Overview',
        'orders': 'Orders Management',
        'create': 'Create New Order',
        'suppliers': 'Supplier Management',
        'register': 'Register New User',
        'tickets': 'Support Tickets'
      };
      document.getElementById('page-title').innerText = titles[tabId];
    }

    function filterOrders(type, element) {
      // Update sub-tab styles
      document.querySelectorAll('.sub-tab').forEach(el => el.classList.remove('active'));
      element.classList.add('active');

      const rows = document.querySelectorAll('.order-row');
      let visibleCount = 0;

      rows.forEach(row => {
        if (type === 'ALL' || row.dataset.type === type) {
          row.style.display = 'table-row';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Show/hide empty message if no results in this filter
      const emptyMsg = document.getElementById('empty-filter-msg');
      if (visibleCount === 0) {
        if (!emptyMsg) {
          const tbody = document.querySelector('tbody');
          const tr = document.createElement('tr');
          tr.id = 'empty-filter-msg';
          tr.innerHTML = `<td colspan="7" style="text-align: center; color: #94a3b8; padding: 30px;">No ${type === 'ALL' ? '' : type.toLowerCase()} orders found</td>`;
          tbody.appendChild(tr);
        } else {
          emptyMsg.style.display = 'table-row';
          emptyMsg.querySelector('td').innerText = `No ${type === 'ALL' ? '' : type.toLowerCase()} orders found`;
        }
      } else if (emptyMsg) {
        emptyMsg.style.display = 'none';
      }
    }

    function editSupplier(supplier) {
      alert('Edit feature for supplier: ' + supplier.name + ' (ID: ' + supplier.id + '). This would open an edit modal in a full implementation.');
    }

    // Check if URL has a hash to open a specific tab
    window.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash.substring(1);
      if (['dashboard', 'orders', 'create', 'suppliers', 'register', 'tickets'].includes(hash)) {
        const targetNav = Array.from(document.querySelectorAll('.nav-item')).find(el => el.getAttribute('onclick').includes(hash));
        if(targetNav) switchTab(hash, targetNav);
      }

      // Auto-fill client name by email
      const emailInput = document.getElementById('clientEmailInput');
      const nameInput = document.getElementById('clientNameInput');

      if (emailInput && nameInput) {
        emailInput.addEventListener('blur', async () => {
          const email = emailInput.value.trim();
          if (email && email.includes('@')) {
            try {
              nameInput.placeholder = 'Searching...';
              const response = await fetch(`/auth/user-by-email/${encodeURIComponent(email)}`);
              const data = await response.json();
              if (data.success) {
                nameInput.value = data.name;
                nameInput.classList.add('auto-filled');
              } else {
                nameInput.placeholder = 'Enter client name';
              }
            } catch (err) {
              console.error('Error fetching client name:', err);
            }
          }
        });
      }

      // Initialize Doughnut Chart
      const chartCtx = document.getElementById('orderTypeChart');
      if (chartCtx) {
        new Chart(chartCtx, {
          type: 'doughnut',
          data: {
            labels: ['Trading', 'Machinery'],
            datasets: [{
              label: 'Orders',
              data: [<%= orderStats.trading %>, <%= orderStats.machinery %>],
              backgroundColor: ['#4f46e5', 'rgb(128 92 31)'],
              hoverOffset: 8,
              borderWidth: 0,
              borderRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
              legend: {
                display: false
              },
              tooltip: {
                backgroundColor: '#1e293b',
                padding: 12,
                titleFont: { size: 14 },
                bodyFont: { size: 13 },
                displayColors: false
              }
            }
          }
        });
      }
    });
  </script>
</body>
</html>
