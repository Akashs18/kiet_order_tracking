<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Order Details</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      padding: 20px;
    }

    .container {
      max-width: 800px;
      margin: auto;
      background: #fff;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    h2 {
      margin-bottom: 20px;
      text-align: center;
    }

    .info {
      margin-bottom: 20px;
    }

    .info p {
      margin: 5px 0;
    }

    .status {
      font-weight: bold;
      color: #4CAF50;
    }

    @keyframes fillLine {
      from { width: 0%; }
      to { width: 100%; }
    }

    @keyframes stepBounce {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.15); }
    }

    @keyframes stepPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.7); }
      50% { box-shadow: 0 0 0 8px rgba(76, 175, 80, 0); }
    }

    @keyframes slideInStep {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .timeline {
      margin-top: 50px;
      display: flex;
      justify-content: space-between;
      position: relative;
      padding: 0 40px;
      overflow: hidden;
    }

    .timeline::before {
      content: '';
      position: absolute;
      top: 13px;
      left: 40px;
      right: 40px;
      height: 4px;
      background: linear-gradient(to right, #4CAF50 0%, #4CAF50 0%, #e0e0e0 0%, #e0e0e0 100%);
      z-index: 1;
      animation: fillLine 2s ease-out forwards;
    }

    .timeline h3 {
      position: absolute;
      top: -40px;
      left: 0;
      margin: 0;
    }

    .step {
      position: relative;
      z-index: 2;
      flex: 1;
      text-align: center;
      font-size: 14px;
      color: #999;
      animation: slideInStep 0.6s ease-out forwards;
      opacity: 0;
    }

    .step:nth-child(2) { animation-delay: 0.1s; }
    .step:nth-child(3) { animation-delay: 0.2s; }
    .step:nth-child(4) { animation-delay: 0.3s; }
    .step:nth-child(5) { animation-delay: 0.4s; }
    .step:nth-child(6) { animation-delay: 0.5s; }
    .step:nth-child(7) { animation-delay: 0.6s; }

    .step::before {
      content: '';
      display: block;
      width: 25px;
      height: 25px;
      background: #e0e0e0;
      border-radius: 50%;
      margin: 0 auto 10px auto;
      border: 4px solid #f4f6f8;
      transition: all 0.3s ease;
    }

    .step.active {
      color: #333;
      font-weight: bold;
    }

    .step.active::before {
      background: #4CAF50;
      border-color: #eaf7ea;
      animation: stepBounce 0.8s ease-out, stepPulse 2s infinite 0.8s;
      box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3);
    }

    .step:not(.active)::before:hover {
      background: #95d5b2;
      border-color: #d3f9d8;
      transform: scale(1.1);
    }

    .form-section {
      margin-top: 30px;
    }

    select, button {
      padding: 10px;
      margin-top: 10px;
      width: 100%;
    }

    button {
      background: #2196F3;
      color: white;
      border: none;
      cursor: pointer;
    }

    button:hover {
      background: #1976D2;
    }

    .back {
      margin-top: 30px;
      text-align: center;
    }

    .back a {
      display: inline-block;
      text-decoration: none;
      color: white;
      background: #2196F3;
      padding: 12px 24px;
      border-radius: 6px;
      font-weight: 500;
      transition: all 0.3s ease;
      border: none;
    }

    .back a:hover {
      background: #1976D2;
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(33, 150, 243, 0.3);
    }
  </style>

</head>

<body>
  <div class="container">


<h2>Order Details</h2>

<!-- Order Info -->
<div class="info">
  <p><strong>PO Number:</strong> <%= order.po_number %></p>
  <% if (user && user.role === 'ADMIN') { %>
  <p><strong>Supplier:</strong> <%= order.supplier_name || 'N/A' %></p>
  <% } %>
  <p><strong>Expected Delivery:</strong> <%= order.expected_delivery_date ? new Date(order.expected_delivery_date).toLocaleDateString() : 'N/A' %></p>
  <p><strong>Status:</strong> <span class="status"><%= order.status %></span></p>
  <p><strong>Created At:</strong> <%= order.created_at %></p>
</div>

<!-- Timeline -->
<div class="timeline">
  <h3>Status Timeline</h3>

  <div class="step <%= order.created_at ? 'active' : '' %>">
    PENDING <br/>
    <small><%= order.created_at || '' %></small>
  </div>

  <div class="step <%= order.ordered_at ? 'active' : '' %>">
    ORDERED <br/>
    <small><%= order.ordered_at || '' %></small>
  </div>

  <div class="step <%= order.received_at ? 'active' : '' %>">
    RECEIVED <br/>
    <small><%= order.received_at || '' %></small>
  </div>

  <div class="step <%= order.invoiced_at ? 'active' : '' %>">
    INVOICED <br/>
    <small><%= order.invoiced_at || '' %></small>
  </div>

  <div class="step <%= order.dispatched_at ? 'active' : '' %>">
    DISPATCHED <br/>
    <small><%= order.dispatched_at || '' %></small>
  </div>

  <div class="step <%= order.delivered_at ? 'active' : '' %>">
    DELIVERED <br/>
    <small><%= order.delivered_at || '' %></small>
  </div>

</div>

<!-- Update Status (Admin Only) -->
<% if (user && user.role === 'ADMIN') { %>
  <div class="form-section">
    <h3>Update Status</h3>

    <form method="POST" action="/orders/<%= order.id %>/status">
      <select name="status" required>
        <option value="">Select Status</option>
        <option value="PENDING">PENDING</option>
        <option value="ORDERED">ORDERED</option>
        <option value="RECEIVED">RECEIVED</option>
        <option value="INVOICED">INVOICED</option>
        <option value="DISPATCHED">DISPATCHED</option>
        <option value="DELIVERED">DELIVERED</option>
      </select>

      <button type="submit">Update</button>
    </form>
  </div>
<% } %>

<!-- Back -->
<div class="back">
  <a href="/orders#orders">← Back to Orders</a>
</div>


  </div>
</body>
</html>
