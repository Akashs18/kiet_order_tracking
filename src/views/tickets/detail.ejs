<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Ticket Details - Order Tracking</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --sidebar-bg: #0f172a;
      --sidebar-hover: #1e293b;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #334155;
      --text-light: #94a3b8;
      --border: #e2e8f0;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    aside.sidebar {
      width: 260px;
      background: var(--sidebar-bg);
      color: white;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }

    .sidebar-header {
      padding: 20px;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.5px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-links {
      flex: 1;
      padding: 20px 0;
    }

    .nav-item {
      padding: 12px 20px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 10px;
      color: #cbd5e1;
      border-right: 4px solid transparent;
      margin: 2px 0;
    }

    .nav-item:hover, .nav-item.active {
      background: var(--sidebar-hover);
      color: white;
      border-right: 4px solid var(--primary);
    }

    .nav-item svg {
      flex-shrink: 0;
      opacity: 0.8;
      transition: opacity 0.2s ease;
    }

    .nav-item:hover svg, .nav-item.active svg {
      opacity: 1;
    }

    .main-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    header.topbar {
      height: 64px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 30px;
      flex-shrink: 0;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .user-badge {
      background: var(--primary);
      color: white;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }

    main.content {
      flex: 1;
      overflow-y: auto;
      padding: 30px;
    }

    footer.bottombar {
      height: 48px;
      background: var(--surface);
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      color: var(--text-light);
      flex-shrink: 0;
    }

    .card {
      background: var(--surface);
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05);
      padding: 24px;
      margin-bottom: 24px;
      border: 1px solid var(--border);
    }

    .card h3 { margin-bottom: 20px; font-weight: 600; color: #1e293b; }

    .btn {
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); }
    
    .btn-danger { background: #ef4444; color: white; padding: 6px 12px; font-size: 13px; }
    .btn-danger:hover { background: #dc2626; }

    .btn-sm { padding: 6px 12px; font-size: 13px; }

    .status-badge {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      display: inline-block;
    }

    .ticket-header {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 20px;
      margin-bottom: 30px;
      align-items: start;
    }

    .ticket-info {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }

    .info-item {
      background: #f8fafc;
      padding: 16px;
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .info-label { font-size: 12px; color: var(--text-light); font-weight: 600; text-transform: uppercase; margin-bottom: 6px; }
    .info-value { font-size: 16px; font-weight: 600; color: #0f172a; }

    .comment {
      background: #f8fafc;
      padding: 16px;
      border-radius: 8px;
      margin-bottom: 16px;
      border-left: 4px solid var(--primary);
    }

    .comment-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .comment-author { font-weight: 600; color: #0f172a; }
    .comment-date { font-size: 12px; color: var(--text-light); }
    .comment-text { color: #475569; line-height: 1.6; }

    textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-family: inherit;
      font-size: 14px;
      resize: vertical;
      min-height: 100px;
    }

    textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: white;
      text-decoration: none;
      margin-bottom: 20px;
      font-weight: 600;
      padding: 12px 24px;
      background: var(--primary);
      border-radius: 8px;
      transition: all 0.3s ease;
      border: none;
    }

    .back-link:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }
  </style>
</head>

<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
      KIET TECHNOLOGIES
    </div>
  </aside>

  <div class="main-wrapper">
    <!-- Header -->
    <header class="topbar">
      <div>
        <h2 style="font-size: 18px; font-weight: 600; color: #1e293b;">Ticket #<%= ticket.id %></h2>
      </div>
      <div class="user-info">
        <span class="user-badge"><%= user.role %></span>
        <span style="font-size: 14px; font-weight: 500;"><%= user.email %></span>
        <a href="/auth/logout" class="btn btn-danger">Logout</a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="content">
      <a href="/orders#tickets" class="back-link">← Back to Dashboard</a>

      <div class="card">
        <div class="ticket-header">
          <div>
            <h3><%= ticket.title %></h3>
            <p style="color: #64748b; margin-top: 6px;">Raised by <%= ticket.name %> (<%= ticket.email %>)</p>
          </div>
          <% if (user.role === 'ADMIN') { %>
          <form method="POST" action="/tickets/<%= ticket.id %>/status">
            <div style="display: flex; gap: 10px; align-items: center;">
              <label style="color: #475569; font-weight: 500;">Status:</label>
              <select name="status" onchange="this.form.submit()" style="padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; font-family: inherit; font-size: 14px;">
                <option value="OPEN" <%= ticket.status === 'OPEN' ? 'selected' : '' %>>Open</option>
                <option value="IN_PROGRESS" <%= ticket.status === 'IN_PROGRESS' ? 'selected' : '' %>>In Progress</option>
                <option value="RESOLVED" <%= ticket.status === 'RESOLVED' ? 'selected' : '' %>>Resolved</option>
                <option value="CLOSED" <%= ticket.status === 'CLOSED' ? 'selected' : '' %>>Closed</option>
              </select>
            </div>
          </form>
          <% } %>
        </div>

        <div class="ticket-info">
          <div class="info-item">
            <div class="info-label">Priority</div>
            <div class="info-value">
              <span class="status-badge" style="background: <%= ticket.priority === 'URGENT' ? '#fecaca' : ticket.priority === 'HIGH' ? '#fed7aa' : ticket.priority === 'MEDIUM' ? '#fef08a' : '#dcfce7' %>; color: <%= ticket.priority === 'URGENT' ? '#dc2626' : ticket.priority === 'HIGH' ? '#d97706' : ticket.priority === 'MEDIUM' ? '#ca8a04' : '#16a34a' %>;">
                <%= ticket.priority %>
              </span>
            </div>
          </div>
          <div class="info-item">
            <div class="info-label">Status</div>
            <div class="info-value">
              <span class="status-badge" style="background: <%= ticket.status === 'OPEN' ? '#dbeafe' : ticket.status === 'IN_PROGRESS' ? '#fed7aa' : ticket.status === 'RESOLVED' ? '#d1fae5' : '#e5e7eb' %>; color: <%= ticket.status === 'OPEN' ? '#0284c7' : ticket.status === 'IN_PROGRESS' ? '#d97706' : ticket.status === 'RESOLVED' ? '#059669' : '#4b5563' %>;">
                <%= ticket.status %>
              </span>
            </div>
          </div>
          <div class="info-item">
            <div class="info-label">Created On</div>
            <div class="info-value"><%= ticket.created_at ? new Date(ticket.created_at).toLocaleDateString() : 'N/A' %></div>
          </div>
        </div>

        <div style="margin-top: 20px;">
          <h4 style="color: #1e293b; margin-bottom: 12px; font-weight: 600;">Description</h4>
          <p style="color: #475569; line-height: 1.6; white-space: pre-wrap;"><%= ticket.description %></p>
        </div>
      </div>

      <!-- Comments Section -->
      <div class="card">
        <h3>Comments & Updates</h3>

        <% if (comments && comments.length > 0) { %>
          <div style="margin-bottom: 30px;">
            <% comments.forEach(comment => { %>
              <div class="comment">
                <div class="comment-header">
                  <span class="comment-author"><%= comment.name %> <span style="color: #94a3b8; font-size: 13px;">(<%= comment.email %>)</span></span>
                  <span class="comment-date"><%= new Date(comment.created_at).toLocaleString() %></span>
                </div>
                <p class="comment-text"><%= comment.comment %></p>
              </div>
            <% }) %>
          </div>
        <% } %>

        <h4 style="color: #1e293b; margin-bottom: 12px; font-weight: 600;">Add a Comment</h4>
        <form method="POST" action="/tickets/<%= ticket.id %>/comment">
          <textarea name="comment" placeholder="Type your comment here..." required></textarea>
          <div style="margin-top: 12px; display: flex; justify-content: flex-end;">
            <button type="submit" class="btn btn-primary">Post Comment</button>
          </div>
        </form>
      </div>

    </main>

    <!-- Footer -->
    <footer class="bottombar">
      &copy; KIET TECHNOLOGIES Panel UI. All rights reserved.
    </footer>
  </div>

</body>
</html>
